function [pegOut] = mainFFT(pegIn, notches, itter)

    %ask if want to notch filter first
    promptIn = "Notch Filter Data? (y/n)";
    inPrompt = input(promptIn, 's');
    
    if inPrompt == 'y'
    
        [pegIn] = fftItter(pegIn, notches, itter);

    else

        pegOut = pegIn; %#ok
    
    end
    
    promptInExp = "Weighting by Exponential Modification? (y/n)";
    inPromptExp = input(promptInExp, 's');

    if inPromptExp == 'y'

        %exponential modification
        [fftTIC_expMod, modByTIC, expModValues] = expModFFT(pegIn);
    
        pegOut = pegIn;

        %pegOut.tic = fftTIC_expMod;
    
        normFact = max(fftTIC_expMod)/max(pegIn.tic);

        ticOutNorm = fftTIC_expMod/normFact;

        specDataOutNorm = (abs(ifft(modByTIC)));

        for i = 1:size(ticOutNorm, 1)

            normSD = max(specDataOutNorm(i,:))/maPegOut.specData(i,:);

            specDataOutNorm(i,:) = specDataOutNorm(i,:)/normSD;

        end

        pegOut.specdata = specDataOutNorm;
        pegOut.tic = sum(pegOut.specdata, 2);

    else

        pegOut = pegIn;

    end

    f = figure('Name','userFig');
    ax1 = subplot(2,1,1);
    plot(pegIn.tic);
    title('TIC, Pre-FFT Denoise')
    xlabel('Acquisitions')
    ylabel('Abundance')
    
    ax2 = subplot(2,1,2);

    if inPromptExp == 'y'
        plot(ticOutNorm);
    else
        plot(pegOut.tic);
    end

    title('TIC, Post-FFT Denoise')
    xlabel('Acquisitions')
    ylabel('Abundance')
    
    linkaxes([ax1,ax2],'xy');

end